PORT=3102

# PostgreSQL
DATABASE_URL=postgres://pantrypilot:pantrypilot@localhost:5434/pantrypilot

# Redis (BullMQ from Week 3; reserved in Compose)
REDIS_URL=redis://localhost:6379

# Auth — shared Life Atlas Dev JWT with RecipeHub (Development mode)
AUTH_MODE=Development
AUTH_DEV_ISSUER=recipehub-dev
AUTH_DEV_AUDIENCE=recipehub
AUTH_DEV_SIGNING_KEY=RecipeHub-Dev-Signing-Key-At-Least-32-Chars!
# When NODE_ENV=production, Dev auth is refused unless ALLOW_DEV_AUTH=true (Compose lab only).
# ALLOW_DEV_AUTH=true
# AUTH_MODE=Google
# AUTH_GOOGLE_AUTHORITY=https://accounts.google.com
# AUTH_GOOGLE_AUDIENCE=<your-google-oauth-client-id>

# RecipeHub (reads only; no write proxy)
RECIPE_HUB_BASE_URL=http://localhost:8080

# Kafka recipe events (Week 2). Prefer RecipeHub Redpanda on localhost:19092,
# or: docker compose --profile kafka up -d
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=lifeatlas.recipes
KAFKA_GROUP_ID=pantry-pilot
KAFKA_CLIENT_ID=pantry-pilot

# BullMQ (Week 3) — uses REDIS_URL; workers start in-process with the API
BULLMQ_ENABLED=true

# Mark plans projectionStale when newest projected_at older than this (ms)
PROJECTION_STALE_AFTER_MS=604800000
